# Development proxy for /api. The backend runs separately.
JONOMOT_API_PROXY_TARGET=http://127.0.0.1:3001

# Optional public API origin for the built frontend. Leave empty to use /api
# on the same origin, supplied by your hosting reverse proxy.
VITE_API_BASE_URL=

# Static production builds use browser demo mode automatically when no API
# origin is configured. Set browser to use it locally, or api to require a server.
VITE_DEMO_MODE=
